# ─────────────────────────────────────────────
# Telegram Video Downloader Bot — Environment
# ─────────────────────────────────────────────

# Get this from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Telegram user ID (get it from @userinfobot on Telegram)
ADMIN_ID=YOUR_TELEGRAM_USER_ID_HERE

# Terabox ndus cookie — log in to terabox.com,
# open DevTools (F12) → Application → Cookies → copy 'ndus' value
TERABOX_COOKIE=YOUR_TERABOX_NDUS_COOKIE_HERE

# ─── Payment Details (shown to users when they hit the limit) ───
# Fill in your UPI ID, PayPal, or any payment method you accept
PAYMENT_UPI=yourname@upi
PAYMENT_NOTE=Pay ₹49/month for unlimited downloads. Send screenshot to admin after payment.

# ─── Subscription Pricing Display ───
PREMIUM_PRICE=₹49/month
